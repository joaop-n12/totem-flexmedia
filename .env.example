# Template de variaveis de ambiente do Totem FlexMedia.
# Copie para .env e preencha. NUNCA commitar o .env real.
# Em producao, use chmod 600 .env

# --- Flask ------------------------------------------------------------------
# OBRIGATORIA em producao. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
FLASK_ENV=development
SECRET_KEY=gere-uma-chave-segura-para-seu-ambiente
FLASK_DEBUG=true

# --- Cifragem de campos sensiveis ------------------------------------------
# Cifra totp_secret e api_key_secret dos totens em repouso (Fernet).
# OBRIGATORIA em producao. Em dev e' opcional (deriva-se de SECRET_KEY).
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para girar a chave sem downtime, use FIELD_ENCRYPTION_KEYS=nova,antiga
# FIELD_ENCRYPTION_KEY=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=

# --- Super admin (consumido por `flask seed`) ------------------------------
# Se SUPERADMIN_PASSWORD ficar vazio, o seed gera senha forte aleatoria e
# imprime no log uma unica vez. NAO ha mais fallback fixo "flexmedia2024".
SUPERADMIN_EMAIL=flex213@gmail.com
SUPERADMIN_PASSWORD=troque-com-no-minimo-12-caracteres-fortes
SUPERADMIN_NAME=FlexMedia

# --- Banco de dados (opcional — default: SQLite em instance/flexmedia.db) --
# Desenvolvimento usa SQLite local por padrao. Defina DATABASE_URL somente
# quando houver um PostgreSQL configurado.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/totem

# --- LGPD: retencao de InteractionLog em dias (default 90) -----------------
INTERACTION_LOG_RETENTION_DAYS=90

# --- Rate limiter (producao): backend de armazenamento ---------------------
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --- Gunicorn (producao) ---------------------------------------------------
# Onde o gunicorn escuta. Escolha conforme o cenario:
#   127.0.0.1:8000          → backend atras de Nginx (cenario padrao do
#                              install_production.sh, sem expor TCP na LAN).
#   0.0.0.0:8000            → expor diretamente na LAN (kiosk acessado por
#                              outro dispositivo). NAO use sem firewall.
#   unix:/tmp/totem.sock    → socket Unix consumido pelo Nginx (mais rapido
#                              que TCP loopback). Padrao do gunicorn.conf.py.
# GUNICORN_BIND=127.0.0.1:8000

# --- Sensores fisicos do totem (DHT11/DHT22 + HC-SR04) ---------------------
# Necessarios APENAS se este host roda o daemon de sensores
# (`scripts/totem_sensor_daemon.py`). Em servidor remoto sem hardware,
# deixe em branco — o daemon nao roda la.
#
# Segredo compartilhado entre o daemon e o Flask local. Protege o endpoint
# /api/local/wake de chamadas indevidas (combinado com binding loopback).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# TOTEM_WAKE_SECRET=
#
# Credenciais HMAC do proprio totem (gerados na tela de provisionamento).
# Use o mesmo arquivo /etc/totem/credenciais.env consumido pelo daemon.
# TOTEM_API_KEY_ID=tk_...
# TOTEM_API_KEY_SECRET=...
# TOTEM_HEARTBEAT_URL=http://127.0.0.1:8000/api/heartbeat
# TOTEM_WAKE_URL=http://127.0.0.1:8000/api/local/wake
#
# Modelo do sensor de temperatura/umidade: DHT11 ou DHT22. Mesma biblioteca,
# mesma pinagem, mesmo callback — o driver troca a classe da lib e a faixa
# de valores conforme o modelo. Default: DHT22.
# Pode ser definido no .env do projeto OU no /etc/totem/credenciais.env
# (o daemon propaga vars do env-file para os.environ no startup).
# DHT_MODEL=DHT11
#
# Flag canonica para forcar sensores em modo mock:
#   =1 → drivers DHT/HC-SR04 ignoram hardware e emitem leituras sinteticas,
#        overlay "Aproxime-se" e SSE de presenca ficam inertes no Flask.
#   =0 ou ausente → comportamento normal (real no Pi, mock em laptop/VM).
# Util para desenvolver UI no proprio Pi sem barulho dos sensores, ou
# desligar temporariamente sem mexer no systemd.
# TOTEM_DISABLE_SENSORS=0
#
# Alias legado da flag acima (mantido por compatibilidade). Prefira
# TOTEM_DISABLE_SENSORS em codigo novo.
# TOTEM_FORCE_MOCK_SENSORS=1

# --- URL publica HTTPS (Cloudflare Tunnel) ---------------------------------
# Preenchida automaticamente por deploy/install_cloudflared.sh. O install_totem.sh
# le essa variavel pra apontar o Chromium kiosk pra URL HTTPS publica em vez do
# localhost:8000. Tambem pode ser usada por integracoes externas que precisem
# saber o endereco publico do totem (emails, webhooks, etc).
#
# Se nao definida, o kiosk cai no fallback http://localhost:8000/ — funciona
# pra teste local, mas QUEBRA microfone/camera (navegadores bloqueiam
# getUserMedia em HTTP fora de localhost — e o Fully Kiosk gratuito nao tem
# a flag pra contornar).
# TOTEM_PUBLIC_URL=https://pi01.flextotem.uk
